# Same Supabase project as CacaoMarket. Locally it runs from market/ (see README.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Fixed BTC price in USD for offline work. Unset means the live price.
PRECIO_FIJO_USD_BTC=

# Sign-in methods, in order: telefono, correo (comma list). Unset means both, phone first.
NEXT_PUBLIC_INGRESO=
# 1 shows the demo accounts panel on /entrar. Unset or any other value hides it.
NEXT_PUBLIC_DEMO=
# Code for the demo accounts (server only). Unset means 123456, the local test code.
DEMO_CODIGO=
