# Same Supabase project as CacaoMarket. Locally it runs from market/ (see README.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Fixed BTC price in USD for offline work. Unset means the live price.
PRECIO_FIJO_USD_BTC=

# 1 turns on the simulator buttons for transfers. Unset or any other value hides them.
NEXT_PUBLIC_DEMO=

# Clerk sign-in keys. The publishable key is public; the secret key stays on the server.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
