{
  "name": "cacao-ledger",
  "version": "0.1.0",
  "description": "Command-line tool that turns a paid sale into a Salvadoran DTE (factura 01 or CCF 03) and checks it against the Ministry of Finance JSON Schemas.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "next typegen && tsc --noEmit",
    "ledger": "node src/cli.ts",
    "demo": "node src/cli.ts demo",
    "sitio": "node src/sitio.ts",
    "dev": "next dev -p 4325",
    "build": "next build",
    "start": "next start -p 4325"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "next": "16.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "^7.0.2"
  }
}
