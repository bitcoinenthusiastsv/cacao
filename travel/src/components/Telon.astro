---
// Curtain for Cacao Travel: a one-time intro and a short loader between pages.
//
// Intro (first page of a session, or any URL with ?intro=1): a ticket is issued. It rises, the bean
// is stamped on it, the wordmark prints, the perforation is cut, the stub fills in, and the ticket
// tears along the perforation to reveal the site. The intro always ends within 2 seconds of
// navigation start and does not wait for the page to finish loading.
// Loader (every later in-site navigation): the two halves of the bean breathing apart and together.
//
// Everything is switched on by classes the inline script puts on <html>, so without JavaScript the
// curtain never appears. Styles and scripts are inline so they are ready before the first paint.
---

<script is:inline>
  (function () {
    var d = document.documentElement;
    try {
      var s = sessionStorage;
      var pedido = /[?&]intro=1(&|$)/.test(location.search);
      var quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (pedido || (!s.getItem('ct-intro') && !quieto)) {
        d.classList.add('ct-intro');
        s.setItem('ct-intro', '1');
        s.removeItem('ct-nav');
      } else if (s.getItem('ct-nav')) {
        d.classList.add('ct-cargando');
        s.removeItem('ct-nav');
      }
    } catch (e) {}
  })();
</script>

<div id="ct-telon" role="status" aria-live="polite">
  <div class="ct-boleto" aria-hidden="true">
    <div class="ct-cuerpo">
      <svg class="ct-sello" viewBox="-50 -50 100 100">
        <circle class="ct-onda" r="34"></circle>
        <g transform="rotate(30)">
          <path class="ct-izq" d="M0,-35.69 A40,40 0 0 0 0,35.69 Z" fill="#2A1912"></path>
          <path class="ct-der" d="M0,-35.69 A40,40 0 0 1 0,35.69 Z" fill="#D9902F"></path>
        </g>
      </svg>
      <span class="ct-marca"><b>cacao</b>travel</span>
    </div>
    <div class="ct-talon">
      <span class="ct-perfo"></span>
      <dl>
        <div><dt>Destino</dt><dd>El Salvador</dd></div>
        <div><dt>Pago</dt><dd>Satoshis</dd></div>
        <div><dt>Clase</dt><dd>Experiencia</dd></div>
      </dl>
    </div>
  </div>

  <svg class="ct-mini" viewBox="-50 -50 100 100" aria-hidden="true">
    <g transform="rotate(30)">
      <path class="ct-izq" d="M0,-35.69 A40,40 0 0 0 0,35.69 Z" fill="#F5EDE3"></path>
      <path class="ct-der" d="M0,-35.69 A40,40 0 0 1 0,35.69 Z" fill="#D9902F"></path>
    </g>
  </svg>

  <p class="ct-rotulo">
    <span class="ct-solo-intro">Emitiendo tu boleto</span>
    <span class="ct-solo-carga">Cargando</span>
  </p>
  <button type="button" class="ct-saltar">Saltar</button>
</div>

<style is:inline>
  #ct-telon { display: none; }
  .ct-intro, .ct-intro body { overflow: hidden; }

  .ct-intro #ct-telon,
  .ct-cargando #ct-telon {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: clamp(20px, 4vh, 40px);
    background: #2a1912;
    color: #f5ede3;
    font-family: 'Bricolage Grotesque Variable', 'Bricolage Grotesque', system-ui, sans-serif;
  }
  .ct-cargando #ct-telon { animation: ct-entra 0.15s ease both; }

  /* What each mode shows. */
  .ct-cargando .ct-boleto, .ct-cargando .ct-saltar, .ct-cargando .ct-solo-intro,
  .ct-intro .ct-mini, .ct-intro .ct-solo-carga { display: none; }

  /* The ticket: body and stub are separate pieces so they can tear apart. */
  .ct-boleto { --ancho: min(520px, 84vw); width: var(--ancho); animation: ct-sube 0.35s cubic-bezier(0.22, 1, 0.36, 1) 0s both; }
  .ct-cuerpo, .ct-talon { background: #f5ede3; color: #2a1912; }
  .ct-cuerpo {
    display: flex;
    align-items: center;
    gap: calc(var(--ancho) * 0.03);
    padding: calc(var(--ancho) * 0.09) calc(var(--ancho) * 0.07);
    border-radius: 28px 28px 0 0;
  }
  .ct-sello { width: calc(var(--ancho) * 0.17); height: calc(var(--ancho) * 0.17); flex: none; overflow: visible; }
  .ct-sello .ct-izq { animation: ct-izq 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s both; }
  .ct-sello .ct-der { animation: ct-der 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s both; }
  .ct-onda {
    fill: none;
    stroke: #d9902f;
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0; /* invisible until the stamp lands */
    animation: ct-onda 0.4s cubic-bezier(0.33, 1, 0.68, 1) 0.3s forwards;
  }
  /* The wordmark is printed, letter by letter, like a ticket printer. */
  .ct-marca {
    font-size: calc(var(--ancho) * 0.125);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1;
    white-space: nowrap;
    clip-path: inset(-10% 100% -10% 0);
    animation: ct-imprime 0.35s steps(11, end) 0.35s forwards;
  }
  .ct-marca b { font-weight: 800; }

  .ct-talon { position: relative; padding: calc(var(--ancho) * 0.05) calc(var(--ancho) * 0.07) calc(var(--ancho) * 0.06); border-radius: 0 0 28px 28px; }
  .ct-talon::before,
  .ct-talon::after {
    content: '';
    position: absolute;
    top: -12px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #2a1912;
    animation: ct-muesca 0.15s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s both;
  }
  .ct-talon::before { left: -12px; }
  .ct-talon::after { right: -12px; }
  /* Perforation: cut from left to right, then a dot keeps travelling along it while the page loads. */
  .ct-perfo {
    position: absolute;
    top: -1px;
    left: 18px;
    right: 18px;
    border-top: 2px dashed #c9b6a4;
    clip-path: inset(-8px 100% -8px 0);
    animation: ct-corta 0.3s cubic-bezier(0.65, 0, 0.35, 1) 0.62s forwards;
  }
  .ct-perfo::after {
    content: '';
    position: absolute;
    top: -6px;
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d9902f;
    opacity: 0;
    animation: ct-viaja 1.2s cubic-bezier(0.65, 0, 0.35, 1) 1.05s infinite;
  }
  .ct-talon dl { display: grid; grid-template-columns: repeat(3, auto); justify-content: space-between; gap: 12px; margin: 0; }
  .ct-talon dl > div { animation: ct-aparece 0.2s cubic-bezier(0.33, 1, 0.68, 1) both; }
  .ct-talon dl > div:nth-child(1) { animation-delay: 0.72s; }
  .ct-talon dl > div:nth-child(2) { animation-delay: 0.78s; }
  .ct-talon dl > div:nth-child(3) { animation-delay: 0.84s; }
  .ct-talon dt, .ct-rotulo, .ct-saltar { font-family: 'JetBrains Mono', ui-monospace, monospace; text-transform: uppercase; letter-spacing: 0.08em; }
  .ct-talon dt { font-size: clamp(9px, calc(var(--ancho) * 0.021), 11px); color: #6b5648; }
  .ct-talon dd { margin: 2px 0 0; font-size: clamp(13px, calc(var(--ancho) * 0.034), 18px); font-weight: 800; }

  /* Loader between pages: the bean's two halves breathe apart and together. */
  .ct-mini { width: 72px; height: 72px; overflow: visible; }
  .ct-mini .ct-izq { animation: ct-respira-izq 0.8s ease-in-out infinite alternate; }
  .ct-mini .ct-der { animation: ct-respira-der 0.8s ease-in-out infinite alternate; }

  .ct-rotulo { margin: 0; font-size: 12px; color: #d9902f; }
  .ct-intro .ct-rotulo { animation: ct-aparece 0.3s ease 0.15s both; }
  .ct-saltar {
    position: absolute;
    right: clamp(16px, 4vw, 40px);
    bottom: clamp(16px, 4vh, 40px);
    padding: 0.7em 1.2em;
    border: 1.5px solid #5a3221;
    border-radius: 999px;
    background: transparent;
    color: #f5ede3;
    font-size: 12px;
    cursor: pointer;
    animation: ct-aparece 0.3s ease 0.2s both;
  }
  .ct-saltar:hover { border-color: #d9902f; color: #d9902f; }
  .ct-saltar:focus-visible { outline: 3px solid #d9902f; outline-offset: 3px; }

  /* Exit. Intro: the ticket tears, body up and stub down. Loader: a quick fade. */
  .ct-fuera #ct-telon { pointer-events: none; transition: opacity 0.35s ease 0.2s; opacity: 0; }
  .ct-fuera.ct-cargando #ct-telon { transition: opacity 0.25s ease; }
  .ct-fuera .ct-cuerpo { transition: transform 0.55s cubic-bezier(0.7, 0, 0.84, 0); transform: translateY(-110vh) rotate(-4deg); }
  .ct-fuera .ct-talon { transition: transform 0.55s cubic-bezier(0.7, 0, 0.84, 0); transform: translateY(110vh) rotate(9deg); }
  .ct-fuera .ct-rotulo, .ct-fuera .ct-saltar { transition: opacity 0.2s; opacity: 0; }

  @keyframes ct-entra { from { opacity: 0; } }
  @keyframes ct-sube { from { transform: translateY(48px) rotate(-2deg); opacity: 0; } }
  @keyframes ct-izq { from { transform: translateX(-34px); opacity: 0; } to { transform: translateX(-2.5px); opacity: 1; } }
  @keyframes ct-der { from { transform: translateX(34px); opacity: 0; } to { transform: translateX(2.5px); opacity: 1; } }
  @keyframes ct-onda { from { transform: scale(0.9); opacity: 0.8; } to { transform: scale(1.9); opacity: 0; } }
  @keyframes ct-imprime { to { clip-path: inset(-10% 0 -10% 0); } }
  @keyframes ct-muesca { from { transform: scale(0); } }
  @keyframes ct-corta { to { clip-path: inset(-8px 0 -8px 0); } }
  @keyframes ct-viaja { 0% { left: 0; opacity: 0; } 15%, 85% { opacity: 1; } 100% { left: calc(100% - 10px); opacity: 0; } }
  @keyframes ct-aparece { from { transform: translateY(8px); opacity: 0; } }
  @keyframes ct-respira-izq { from { transform: translateX(-2.5px); } to { transform: translateX(-9px); } }
  @keyframes ct-respira-der { from { transform: translateX(2.5px); } to { transform: translateX(9px); } }

  @media (prefers-reduced-motion: reduce) {
    #ct-telon *, #ct-telon *::before, #ct-telon *::after { animation-duration: 1ms !important; animation-delay: 0s !important; animation-iteration-count: 1 !important; }
    .ct-fuera .ct-cuerpo, .ct-fuera .ct-talon { transform: none; }
  }
</style>

<script is:inline>
  (function () {
    var d = document.documentElement;
    var telon = document.getElementById('ct-telon');
    if (!telon) return;
    var inicio = performance.now();
    var enIntro = d.classList.contains('ct-intro');
    var CLASES = ['ct-intro', 'ct-cargando', 'ct-fuera'];

    function quitar() { d.classList.remove.apply(d.classList, CLASES); }

    function fuera() {
      if (d.classList.contains('ct-fuera')) return;
      if (!d.classList.contains('ct-intro') && !d.classList.contains('ct-cargando')) return;
      d.classList.add('ct-fuera');
      setTimeout(quitar, enIntro ? 580 : 280);
    }

    // Leave once the page is ready, but never before the animation has had its minimum time.
    function alEstarLista(evento, minimo) {
      var seguir = function () { setTimeout(fuera, Math.max(0, minimo - (performance.now() - inicio))); };
      if (document.readyState === 'complete' || (evento === 'DOMContentLoaded' && document.readyState !== 'loading')) seguir();
      else addEventListener(evento, seguir, { once: true });
    }

    if (enIntro) {
      // The tear starts 1.3 s after navigation start, whatever the page is still loading.
      // The tear takes 0.58 s, so the intro is gone by about 1.9 s, with margin under the 2 s limit.
      setTimeout(fuera, Math.max(0, 1300 - performance.now()));
      telon.querySelector('.ct-saltar').addEventListener('click', fuera);
      addEventListener('keydown', function (e) { if (e.key === 'Escape') fuera(); });
    } else if (d.classList.contains('ct-cargando')) {
      alEstarLista('DOMContentLoaded', 350);
    }

    // Show the loader as soon as the visitor follows a link to another page of this site.
    addEventListener('click', function (e) {
      if (e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      var a = e.target.closest && e.target.closest('a[href]');
      if (!a || (a.target && a.target !== '_self') || a.hasAttribute('download')) return;
      var u = new URL(a.href, location.href);
      var mismaPagina = u.pathname === location.pathname && u.search === location.search;
      if (u.origin !== location.origin || mismaPagina || u.pathname.indexOf('/api/') === 0) return;
      try { sessionStorage.setItem('ct-nav', '1'); } catch (_) {}
      enIntro = false;
      d.classList.remove('ct-intro', 'ct-fuera');
      d.classList.add('ct-cargando');
      setTimeout(quitar, 8000); // navigation was cancelled or failed
    });

    // Coming back with the browser's back button restores the page as it was left: clear the curtain.
    addEventListener('pageshow', function (e) {
      if (!e.persisted) return;
      quitar();
      try { sessionStorage.removeItem('ct-nav'); } catch (_) {}
    });
  })();
</script>
