---
import Base from '../layouts/Base.astro';
import { CATEGORIAS } from '../content.config';
import { todosLosTours, urlTour, sats, coordenadas } from '../lib/tours';

const tours = await todosLosTours();
const puntos = tours.flatMap((t) => {
  const c = coordenadas(t.data.coords);
  if (!c) return [];
  return [
    {
      id: t.id,
      titulo: t.data.titulo,
      lugar: t.data.lugar,
      categoria: t.data.categoria,
      duracion: t.data.duracion,
      nivel: t.data.nivel,
      precio: sats(t.data.precio),
      url: urlTour(t),
      foto: t.data.portada,
      lat: c[0],
      lng: c[1],
    },
  ];
});
const categorias = CATEGORIAS.filter((c) => puntos.some((p) => p.categoria === c));
---

<Base titulo="Mapa de experiencias" descripcion="Mapa de las experiencias en El Salvador. Precios en sats.">
  <section class="contenedor cabeza">
    <h1>Mapa de experiencias</h1>
    <p>{puntos.length} experiencias en El Salvador. Tocá un punto para ver el precio.</p>
  </section>

  <section class="contenedor mapa-seccion">
    <div class="filtros" role="group" aria-label="Categorías">
      <button type="button" data-filtro="" aria-pressed="true">Todas</button>
      {categorias.map((c) => <button type="button" data-filtro={c} aria-pressed="false">{c}</button>)}
    </div>

    <div class="mapa-layout">
      <div id="mapa" class="mapa" role="application" aria-label="Mapa de experiencias"></div>

      <div class="lateral">
        <p class="cuenta" aria-live="polite" data-mapa-cuenta></p>
        {puntos.length === 0 && <p class="vacio">Todavía no hay experiencias con ubicación en el mapa.</p>}
        <ol class="lista">
          {puntos.map((p) => (
            <li data-categoria={p.categoria}>
              <button type="button" class="lista__boton">
                <span class="lista__titulo">{p.titulo}</span>
                <span class="lista__meta">{p.lugar} · {p.duracion}</span>
                <span class="lista__precio">{p.precio}</span>
              </button>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</Base>

<script type="application/json" id="puntos-datos" set:html={JSON.stringify(puntos)} />

<style>
  .cabeza { padding-block: clamp(24px, 5vw, 64px) 20px; display: grid; gap: 12px; }
  .cabeza h1 { font-size: var(--t-h1); }
  .cabeza p { color: var(--tinta-suave); max-width: 60ch; }

  .mapa-seccion { display: grid; gap: clamp(16px, 2.5vw, 24px); padding-bottom: clamp(48px, 7vw, 96px); min-width: 0; }

  .filtros { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: none; }
  .filtros::-webkit-scrollbar { display: none; }
  .filtros button {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 0.6em 1.15em;
    border: 1.5px solid var(--chocolate);
    border-radius: 999px;
    background: transparent;
    color: var(--tostado);
    font: 600 0.9375rem/1 var(--fuente);
    cursor: pointer;
  }
  .filtros button:hover { border-color: var(--mazorca); color: var(--mazorca); }
  .filtros button[aria-pressed='true'] { background: var(--mazorca); border-color: var(--mazorca); color: var(--tostado); }

  .mapa-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(16px, 2vw, 24px); min-width: 0; }
  @media (min-width: 960px) {
    .mapa-layout { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); align-items: start; }
  }

  .mapa {
    width: 100%;
    min-width: 0;
    height: min(70vh, 640px);
    border-radius: var(--radio);
    overflow: hidden;
    background: var(--chocolate);
    font-family: var(--fuente);
  }
  .mapa :global(.punto) {
    width: 22px;
    height: 22px;
    box-sizing: border-box;
    border-radius: 50%;
    background: var(--mazorca);
    border: 3px solid var(--tostado);
  }
  .mapa :global(.leaflet-popup-content-wrapper) {
    background: var(--pulpa);
    color: var(--tostado);
    border-radius: var(--radio-chico);
    box-shadow: none;
  }
  .mapa :global(.leaflet-popup-tip) { background: var(--pulpa); box-shadow: none; }
  .mapa :global(.leaflet-popup-content) { margin: 12px; font-family: var(--fuente); }
  .mapa :global(.leaflet-popup-close-button) { color: var(--tostado); }
  .mapa :global(.popup__foto) {
    display: block;
    width: 220px;
    max-width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 8px;
  }
  .mapa :global(.popup__categoria) {
    margin-top: 8px;
    color: var(--criollo);
    font-size: 0.75rem;
  }
  .mapa :global(.popup__titulo) { font-weight: 800; line-height: 1.2; margin-top: 2px; }
  .mapa :global(.popup__datos) { font-size: 0.875rem; margin-top: 4px; }
  .mapa :global(.popup__precio) { font-family: var(--mono); font-weight: 500; margin-top: 4px; }
  .mapa :global(.popup__enlace) { color: var(--tostado); font-weight: 700; text-decoration: underline; }
  .mapa :global(.leaflet-bar) { box-shadow: none; border: 0; }
  .mapa :global(.leaflet-bar a) { background: var(--tostado); color: var(--pulpa); border-bottom-color: var(--chocolate); }
  .mapa :global(.leaflet-bar a:hover) { background: var(--chocolate); color: var(--mazorca); }
  .mapa :global(.leaflet-control-zoom a) { width: 36px; height: 36px; line-height: 36px; }
  .mapa :global(.leaflet-control-attribution) { background: var(--tostado); color: var(--arena-oscura); }
  .mapa :global(.leaflet-control-attribution a) { color: var(--pulpa); }

  .lateral { display: grid; gap: 12px; min-width: 0; }
  .cuenta { font-size: 0.9375rem; color: var(--tinta-suave); }
  .vacio { padding: 20px; background: var(--chocolate); border-radius: var(--radio-chico); color: var(--pulpa); }

  .lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; min-width: 0; }
  .lista li[hidden] { display: none; }
  .lista__boton {
    width: 100%;
    min-width: 0;
    display: grid;
    gap: 4px;
    padding: 14px 16px 14px 14px;
    border: 0;
    border-left: 6px solid transparent;
    border-radius: var(--radio-chico);
    background: var(--chocolate);
    color: var(--pulpa);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .lista__boton:hover { color: var(--mazorca); }
  .lista__boton[aria-current='true'] { border-left-color: var(--mazorca); }
  .lista__titulo { font-weight: 800; font-size: 1.0625rem; line-height: 1.2; overflow-wrap: anywhere; }
  .lista__meta { font-size: 0.9375rem; color: var(--arena); overflow-wrap: anywhere; }
  .lista__precio { font-family: var(--mono); font-size: 0.875rem; color: var(--pulpa); }

  @media (min-width: 960px) {
    .lista { max-height: min(70vh, 640px); overflow-y: auto; padding-right: 4px; }
  }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  type Punto = {
    id: string;
    titulo: string;
    lugar: string;
    categoria: string;
    duracion: string;
    nivel: string;
    precio: string;
    url: string;
    foto: string;
    lat: number;
    lng: number;
  };

  const puntos: Punto[] = JSON.parse(document.getElementById('puntos-datos')!.textContent!);

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, clase: string, texto?: string): HTMLElementTagNameMap[K] {
    const nodo = document.createElement(tag);
    nodo.className = clase;
    if (texto !== undefined) nodo.textContent = texto;
    return nodo;
  }

  function nodoPopup(p: Punto): HTMLElement {
    const caja = el('div', 'popup');

    const foto = el('img', 'popup__foto');
    foto.src = p.foto;
    foto.alt = '';
    foto.width = 220;
    foto.loading = 'lazy';

    const enlace = el('a', 'popup__enlace', 'Ver la experiencia');
    enlace.href = p.url;

    caja.append(
      foto,
      el('p', 'popup__categoria dato', p.categoria),
      el('p', 'popup__titulo', p.titulo),
      el('p', 'popup__datos', `${p.lugar} · ${p.duracion} · ${p.nivel}`),
      el('p', 'popup__precio', p.precio),
      enlace,
    );
    return caja;
  }

  const mapa = L.map('mapa', { scrollWheelZoom: false });

  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 17,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  }).addTo(mapa);

  if (puntos.length) {
    const limites = L.latLngBounds(puntos.map((p) => [p.lat, p.lng] as L.LatLngTuple));
    mapa.fitBounds(limites, { padding: [32, 32] });
  } else {
    mapa.setView([13.7, -88.9], 9);
  }

  const icono = L.divIcon({ className: 'punto', iconSize: [22, 22], iconAnchor: [11, 11] });

  const marcadores = puntos.map((p, i) => {
    const marcador = L.marker([p.lat, p.lng], { icon: icono, keyboard: false, title: p.titulo });
    marcador.bindPopup(nodoPopup(p), { maxWidth: 240 });
    marcador.addTo(mapa);
    marcador.on('click', () => activar(i));
    return marcador;
  });

  const botones = [...document.querySelectorAll<HTMLButtonElement>('.lista__boton')];
  const items = botones.map((b) => b.closest('li') as HTMLLIElement);
  const filtros = [...document.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
  const cuenta = document.querySelector<HTMLElement>('[data-mapa-cuenta]');
  let filtro = '';

  function activar(i: number) {
    botones.forEach((b, j) => {
      if (j === i) b.setAttribute('aria-current', 'true');
      else b.removeAttribute('aria-current');
    });
  }

  function irA(i: number) {
    activar(i);
    const p = puntos[i];
    const marcador = marcadores[i];
    mapa.flyTo([p.lat, p.lng], Math.max(mapa.getZoom(), 12), { duration: 0.6 });
    mapa.once('moveend', () => marcador.openPopup());
  }

  function aplicarFiltro() {
    let visibles = 0;
    puntos.forEach((p, i) => {
      const ver = !filtro || p.categoria === filtro;
      if (ver) {
        marcadores[i].addTo(mapa);
        visibles++;
      } else {
        marcadores[i].remove();
      }
      items[i].hidden = !ver;
    });
    if (cuenta) cuenta.textContent = `Mostrando ${visibles} de ${puntos.length}`;
  }

  for (const chip of filtros) {
    chip.addEventListener('click', () => {
      filtro = chip.dataset.filtro ?? '';
      for (const otro of filtros) otro.setAttribute('aria-pressed', String(otro === chip));
      aplicarFiltro();
    });
  }

  botones.forEach((b, i) => b.addEventListener('click', () => irA(i)));

  aplicarFiltro();
</script>
