---
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/global.css';
import GrupoCacao from '../components/GrupoCacao.astro';
import Logo from '../components/Logo.astro';
import { SECCIONES, type SeccionId } from '../lib/secciones';
import { TRAVEL_URL } from '../lib/travel';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** Tints the page with the section accent and marks the nav pill as current. */
  seccion?: SeccionId;
  imagen?: string;
  /** Leave the group block out of the footer when the page shows it in its own section. */
  sinGrupo?: boolean;
}
const {
  titulo,
  descripcion = 'Crónicas, guías y cultura local. Sin suscripciones: pagás solo lo que leés.',
  seccion,
  imagen,
  sinGrupo = false,
} = Astro.props;
const tituloCompleto = titulo ? `${titulo} — Cacao Media` : 'Cacao Media — Historias de El Salvador';
const canonica = new URL(Astro.url.pathname, Astro.site);
// The admin link shows only in demo builds.
const demo = import.meta.env.PUBLIC_DEMO === '1';
---

<!doctype html>
<html lang="es-SV">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Cacao Media" href="/rss.xml" />
    <meta name="theme-color" content="#2A1912" />
    <!-- Stories are unverified drafts. Remove this line (and public/robots.txt) once they are fact-checked. -->
    <meta name="robots" content="noindex" />
    <meta property="og:site_name" content="Cacao Media" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    {imagen && <meta property="og:image" content={new URL(imagen, Astro.site)} />}
  </head>
  <body data-seccion={seccion}>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <div class="hoja">
      <div class="barra">
      <header class="cabecera contenedor">
        <a class="cabecera__logo" href="/" aria-label="Cacao Media, inicio"><Logo /></a>
        <nav class="cabecera__nav" aria-label="Secciones">
          {
            SECCIONES.map((s) => (
              <a
                class="pastilla"
                data-seccion={s.id}
                href={`/${s.ruta}/`}
                aria-current={seccion === s.id ? 'page' : undefined}
              >
                {s.plural}
              </a>
            ))
          }
          <a class="pastilla cabecera__travel" href={`${TRAVEL_URL}/`}>Travel</a>
        </nav>
        <div class="cabecera__extra">
          <a class="etiqueta" href="/archivo/">Archivo</a>
          <a class="etiqueta" href="/acerca/">Acerca</a>
        </div>
      </header>
      </div>
      <main id="contenido" tabindex="-1">
        <slot />
      </main>
    </div>
    <footer class="pie contenedor">
      <p class="pie__gigante" aria-hidden="true"><b>cacao</b>media</p>
      <Logo fondo="oscuro" altura={28} />
      <p>Historias de El Salvador, grano a grano.</p>
      <nav aria-label="Pie">
        <a href="/archivo/">Archivo</a>
        <a href={`${TRAVEL_URL}/`}>Cacao Travel</a>
        <a href="/acerca/">Acerca</a>
        <a href="/acerca/#linea-editorial">Línea editorial</a>
        <a href="/creditos/">Créditos de fotos</a>
        <a href="/rss.xml">RSS</a>
        {demo && <a href="/admin/">Panel</a>}
      </nav>
      <p class="etiqueta">13.69°N · 89.22°W · San Salvador</p>
      {!sinGrupo && <GrupoCacao actual="media" />}
    </footer>
  </body>
</html>

<style>
  .saltar { position: absolute; left: -999px; top: 8px; background: var(--mazorca); color: var(--tostado); padding: 0.5em 1em; border-radius: 999px; z-index: 10; }
  .saltar:focus { left: 8px; }

  /* Dirt-style sheet: Pulpa page with rounded bottom corners on a Tostado ground. */
  .hoja {
    background: var(--pulpa);
    margin-inline: clamp(0px, 1.5vw, 20px);
    border-radius: 0 0 var(--radio) var(--radio);
    padding-bottom: clamp(48px, 8vw, 96px);
  }

  .barra { background: var(--pulpa); }
  @media (min-width: 861px) {
    .barra { position: sticky; top: 0; z-index: 5; }
  }

  /* The skip link focuses main; no ring around the whole page. */
  main:focus { outline: none; }

  .cabecera {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding-block: 16px;
    border-bottom: 1.5px solid var(--tostado);
  }
  /* Explicit placement, not `order`, so the DOM and Tab order read logo, pills, links. */
  .cabecera__logo { grid-row: 1; grid-column: 2; text-decoration: none; justify-self: center; }
  .cabecera__nav { grid-row: 1; grid-column: 1; display: flex; flex-wrap: wrap; gap: 6px; }
  .cabecera__nav .pastilla { min-height: 36px; }
  .cabecera__nav .pastilla[aria-current='page'] { background: var(--tostado); color: var(--pulpa); }
  .cabecera__travel { background: var(--tostado); color: var(--pulpa); }
  .cabecera__travel:hover { background: var(--mazorca) !important; color: var(--tostado) !important; }
  .cabecera__extra { grid-row: 1; grid-column: 3; display: flex; gap: 18px; justify-self: end; }
  /* Padding makes the tap area 36px tall; the negative margin keeps the text where it was. */
  .cabecera__extra a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding-inline: 8px;
    margin-inline: -8px;
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .cabecera { grid-template-columns: minmax(0, 1fr); }
    .cabecera__logo { grid-row: 1; grid-column: 1; justify-self: start; }
    .cabecera__nav { grid-row: 2; grid-column: 1; }
    .cabecera__extra { grid-row: 3; grid-column: 1; justify-self: start; }
  }
  @media (max-width: 480px) {
    .cabecera__logo :global(.logo) { font-size: 26px !important; }
    .cabecera__extra { gap: 12px; }
  }

  .pie {
    display: grid;
    gap: 14px;
    padding-block: clamp(40px, 6vw, 72px);
    color: var(--pulpa);
  }
  .pie { overflow: hidden; }
  .pie__gigante {
    font-size: clamp(3rem, 16.5vw, 15rem);
    font-weight: 400;
    line-height: 0.8;
    letter-spacing: -0.045em;
    white-space: nowrap;
    color: var(--chocolate);
    margin-bottom: clamp(16px, 3vw, 40px);
  }
  .pie__gigante b { font-weight: 800; }
  .pie nav { display: flex; flex-wrap: wrap; gap: 20px; }
  .pie a:hover { color: var(--mazorca); }
  .pie .etiqueta { color: var(--arena-oscura); }
</style>
