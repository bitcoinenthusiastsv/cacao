---
// Sign-in page for the admin panel: the Clerk sign-in form. A visitor who is already signed in is
// sent to /admin/, which either opens the panel or answers 404.
import Panel from './_panel.astro';
import { SignIn } from '@clerk/astro/components';
import { accesoAdmin } from '../../lib/servidor/admin-acceso';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
if ((await accesoAdmin(Astro)).estado !== 'sin-sesion') return Astro.redirect('/admin/');
---

<Panel titulo="Entrar">
  <div class="entrar">
    <h2 class="seccion-titulo">Entrar</h2>
    <p class="nota">Entrá con tu cuenta. Solo las cuentas de administración ven el panel.</p>
    <SignIn routing="hash" forceRedirectUrl="/admin/" />
  </div>
</Panel>

<style>
  /* One centered column: the page title over Clerk's card, whose own title is hidden so it shows once. */
  .entrar { display: grid; justify-items: center; gap: 16px; max-width: 34rem; margin-inline: auto; text-align: center; }
  .entrar :global(.cl-rootBox) { width: 100%; max-width: 26rem; text-align: start; }
  .entrar :global(.cl-headerTitle) { display: none; }
</style>
