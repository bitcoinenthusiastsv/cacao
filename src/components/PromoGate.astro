---
import Simbolo from './Simbolo.astro';
---

<section class="promo">
  <div class="promo__simbolo">
    <Simbolo tamano={72} fondo="oscuro" decorativo />
  </div>
  <div class="promo__texto">
    <p class="etiqueta">Cacao Gate</p>
    <h2 class="promo__titulo">Pagás solo la historia que querés.</h2>
    <p class="promo__linea">Desde 120 sats por historia. Sin cuenta, sin suscripción. Acceso por 7 días en tu dispositivo.</p>
    <p class="etiqueta promo__demo">Modo demo · no se cobra nada</p>
    <a class="boton promo__boton" href="/acerca/#cacao-gate">Cómo funciona Cacao Gate</a>
  </div>
</section>

<style>
  .promo {
    display: grid;
    gap: clamp(20px, 4vw, 40px);
    align-items: center;
    padding: clamp(24px, 5vw, 56px);
    background: var(--tostado);
    color: var(--pulpa);
    border-radius: var(--radio);
  }

  @media (min-width: 800px) {
    .promo {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }

  .promo__texto {
    display: grid;
    gap: 14px;
    justify-items: start;
    min-width: 0;
  }

  .promo__titulo {
    font-size: var(--t-h1);
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .promo__linea {
    overflow-wrap: anywhere;
  }

  .promo__demo {
    color: var(--mazorca);
  }

  .promo__boton:hover {
    background: var(--pulpa);
    color: var(--tostado);
  }
</style>
