---
interface Props {
  id?: string;
}
const { id = 'correo-boletin' } = Astro.props;
---

<section class="promo">
  <h2 class="promo__titulo">Recibí Cacao en tu correo.</h2>
  <p class="promo__linea">Una historia nueva cada semana. Sin spam, sin suscripción paga.</p>
  <form class="promo__form" data-boletin>
    <label class="solo-lectores" for={id}>Tu correo</label>
    <input
      class="promo__input"
      id={id}
      type="email"
      required
      placeholder="tu@correo.com"
      autocomplete="email"
    />
    <button class="boton boton--oscuro promo__boton" type="submit">Anotarme</button>
  </form>
  <p class="etiqueta" data-boletin-nota>Modo demo · todavía no enviamos correos</p>
</section>

<script>
  const NOTA_ENVIADA = 'Anotado en modo demo. Todavía no guardamos tu correo.';

  document.querySelectorAll<HTMLFormElement>('[data-boletin]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const nota = form.parentElement?.querySelector<HTMLElement>('[data-boletin-nota]');
      if (nota) nota.textContent = NOTA_ENVIADA;
    });
  });
</script>

<style>
  .promo {
    display: grid;
    gap: 16px;
    padding: clamp(24px, 5vw, 56px);
    background: var(--mazorca);
    color: var(--tostado);
    border-radius: var(--radio);
  }

  .promo__titulo {
    font-size: var(--t-h1);
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .promo__linea {
    overflow-wrap: anywhere;
  }

  .promo__form {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .promo__input {
    flex: 1 1 260px;
    min-width: 0;
    width: 100%;
    padding: 0.8em 1.2em;
    background: var(--pulpa);
    color: var(--tostado);
    border: 1.5px solid var(--tostado);
    border-radius: 999px;
    font: inherit;
  }
  .promo__input::placeholder {
    color: var(--tinta-suave);
  }

  .promo__boton {
    flex: 0 0 auto;
  }
  .promo__boton:hover {
    background: var(--pulpa);
    color: var(--tostado);
  }
</style>
